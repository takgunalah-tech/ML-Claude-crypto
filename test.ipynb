    "import yfinance as yf\n",
    "import pandas as pd\n",
    "\n",
    "def test_ticker(symbol):\n",
    "    print(f\"--- Testing Ticker: {symbol} ---\")\n",
    "    try:\n",
    "        # Download data\n",
    "        data = yf.download(symbol, period=\"3d\", interval=\"1h\", progress=False)\n",
    "\n",
    "        if data.empty:\n",
    "            print(f\"Result: No data found for {symbol}.\\n\")\n",
    "            return\n",
    "\n",
    "        # Check for Timezone\n",
    "        is_tz_aware = data.index.tz is not None\n",
    "        tz_name = data.index.tz if is_tz_aware else \"None (Naive)\"\n",
    "        print(f\"Data found! Rows: {len(data)}\")\n",
    "        print(f\"Timezone: {tz_name}\")\n",
    "\n",
    "        # FIX: Access the 'Close' column safely even if it's a MultiIndex\n",
    "        # We use .iloc[-1] on the specific column to get a single float value\n",
    "        if isinstance(data['Close'], pd.DataFrame):\n",
    "            last_price = data['Close'][symbol].iloc[-1]\n",
    "        else:\n",
    "            last_price = data['Close'].iloc[-1]\n",
    "\n",
    "        print(f\"Latest Price: {last_price:.4f}\")\n",
    "        print(f\"Last timestamp: {data.index[-1]}\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"An error occurred: {e}\")\n",
    "    print(\"-\" * 30 + \"\\n\")\n",
    "\n",
    "\n"
   ]
  },
